/-- Option hashing: tag then value (Rust hashes the discriminant first). -/
def option.Option.Insts.CoreHashHash.hash
    {T H : Type} (hashInst : core.hash.Hash T)
    (hasherInst : core.hash.Hasher H)
    (self : core.option.Option T) (state : H) : RustM H := do
  match self with
  | core.option.Option.None =>
    core.U8.Insts.CoreHashHash.hash hasherInst 0#u8 state
  | core.option.Option.Some x => do
    let state ← core.U8.Insts.CoreHashHash.hash hasherInst 1#u8 state
    hashInst.hash hasherInst x state

