    cloneK cloneV cloneAlloc
  clone_from := core.clone.Clone.clone_from.default
    (collections.btree.map.BTreeMap.Insts.CoreCloneClone cloneK cloneV cloneAlloc)
}

/-- Pairwise equality over equal-length association lists. -/
def collections.btree.map.BTreeMap.Insts.CoreCmpPartialEqBTreeMap.eq
    {K V A : Type} (eqK : core.cmp.PartialEq K K) (eqV : core.cmp.PartialEq V V)
    (_cloneAlloc : core.clone.Clone A)
    (self other : collections.btree.map.BTreeMap K V A) : RustM Bool := do
  if self.length != other.length then
    pure false
  else
    List.allM (fun ((k1, v1), (k2, v2)) => do
      let bk ← eqK.eq k1 k2
      if bk then eqV.eq v1 v2 else pure false) (self.zip other)

def collections.btree.map.BTreeMap.Insts.CoreCmpPartialEqBTreeMap.ne
    {K V A : Type} (eqK : core.cmp.PartialEq K K) (eqV : core.cmp.PartialEq V V)
    (cloneAlloc : core.clone.Clone A)
    (self other : collections.btree.map.BTreeMap K V A) : RustM Bool := do
  let b ← collections.btree.map.BTreeMap.Insts.CoreCmpPartialEqBTreeMap.eq
    eqK eqV cloneAlloc self other
  pure !b

