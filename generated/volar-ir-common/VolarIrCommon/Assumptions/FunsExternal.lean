/-- Pair ordering: first component, then second (matches Rust). -/
def Pair.Insts.CoreCmpOrd.cmp
    {A B : Type} (ordA : core.cmp.Ord A) (ordB : core.cmp.Ord B) :
    A × B → A × B → RustM core.cmp.Ordering
  | (a1, b1), (a2, b2) => do
    let o ← ordA.cmp a1 a2
    match o with
    | core.cmp.Ordering.Equal => ordB.cmp b1 b2
    | o => pure o

/-- Pair PartialOrd via element partial comparisons (matches Rust). -/
def Pair.Insts.CoreCmpPartialOrdPair.partial_cmp
    {A B : Type} (poA : core.cmp.PartialOrd A A) (poB : core.cmp.PartialOrd B B)
    (self other : A × B) :
