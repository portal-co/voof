/-- Elementwise clone over the association-list model. The allocator's
Clone instance is taken but unused, mirroring Rust's impl bounds. -/
def collections.btree.map.BTreeMap.Insts.CoreCloneClone.clone
    {K V A : Type} (cloneK : core.clone.Clone K) (cloneV : core.clone.Clone V)
    (_cloneAlloc : core.clone.Clone A)
    (self : collections.btree.map.BTreeMap K V A) :
    RustM (collections.btree.map.BTreeMap K V A) :=
  List.mapM (fun (k, v) => do
    let k1 ← cloneK.clone k
    let v1 ← cloneV.clone v
    pure (k1, v1)) self

/-- Trait implementation (model). -/
