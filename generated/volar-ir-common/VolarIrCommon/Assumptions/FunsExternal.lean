namespace CoreModels

/-- Shared lexicographic comparison over lists of RustM-comparable elements. -/
def lexCmpM {α : Type} (cmp : α → α → RustM core.cmp.Ordering) :
    List α → List α → RustM core.cmp.Ordering
  | [], [] => pure core.cmp.Ordering.Equal
  | [], _ :: _ => pure core.cmp.Ordering.Less
  | _ :: _, [] => pure core.cmp.Ordering.Greater
  | a :: tl1, b :: tl2 => do
    let o ← cmp a b
    match o with
    | core.cmp.Ordering.Equal => lexCmpM cmp tl1 tl2
    | o => pure o

/-- Lexicographic comparison with a partial element comparison. -/
def lexCmpOptM {α : Type}
    (cmp : α → α → RustM (core.option.Option core.cmp.Ordering)) :
    List α → List α → RustM (core.option.Option core.cmp.Ordering)
  | [], [] => pure (core.option.Option.Some core.cmp.Ordering.Equal)
  | [], _ :: _ => pure (core.option.Option.Some core.cmp.Ordering.Less)
  | _ :: _, [] => pure (core.option.Option.Some core.cmp.Ordering.Greater)
  | a :: tl1, b :: tl2 => do
    let o ← cmp a b
    match o with
    | core.option.Option.Some core.cmp.Ordering.Equal => lexCmpOptM cmp tl1 tl2
    | o => pure o

/-- Hash each element of a list in order. -/
def hashListM {α H : Type} (hashInst : core.hash.Hash α)
    (hasherInst : core.hash.Hasher H) : List α → H → RustM H
  | [], st => pure st
  | x :: xs, st => do
    let st ← hashInst.hash hasherInst x st
    hashListM hashInst hasherInst xs st

/-- Ordering as an option, from a total comparison. -/
def someCmp (o : core.cmp.Ordering) : core.option.Option core.cmp.Ordering :=
  core.option.Option.Some o

/-- Is the ordering Less? -/
def orderingIsLess : core.cmp.Ordering → Bool
  | core.cmp.Ordering.Less => true
  | _ => false

/-- Is the ordering Greater? -/
def orderingIsGreater : core.cmp.Ordering → Bool
  | core.cmp.Ordering.Greater => true
  | _ => false

/-- Is the ordering Less or Equal? -/
def orderingIsLe (o : core.cmp.Ordering) : Bool :=
  !orderingIsGreater o

/-- Is the ordering Greater or Equal? -/
def orderingIsGe (o : core.cmp.Ordering) : Bool :=
  !orderingIsLess o

